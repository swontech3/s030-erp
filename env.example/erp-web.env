# =============================================================================
# erp-web.env 견본 — 실제 파일은 저장소 밖 %SWONBIZ_ENV_DIR%\erp-web.env (없으면 C:\workspace\env\)
# =============================================================================
# ★ 이 견본에는 **값을 적지 않는다.** 칸 이름과 설명만 둔다(결정 2026-10-24).
# ★ 읽는 쪽: 화면(Next.js) — common + erp-web. 화면은 admin.env 를 읽지 않는다.
# ★★ `NEXT_PUBLIC_*` 은 **빌드 때 값이 박힌다.** 바꾸면 가동계는 `next build` 를 다시 한다.
#    그 밖의 칸은 화면 **서버**에서만 쓴다 — 브라우저로 내려가지 않는다.

# -----------------------------------------------------------------------------
# 삐용 **화면** 주소 — 로그인 화면의 「비밀번호를 잊으셨나요?」가 쓴다 (★ 빌드 때 박힘)
# -----------------------------------------------------------------------------
# 삐용은 화면과 API 가 다른 서버다. 여기는 **화면** 쪽(API 는 common.env 의 BBIYONG_BASE_URL).
#   개발계 http://192.168.0.22:3000 · 가동계 아직 못 받았다
# 비워 두어도 로그인은 멀쩡하다 — 링크 대신 「운영사에 문의」만 띄운다(결정 2026-10-05).
NEXT_PUBLIC_BBIYONG_WEB_URL=

# -----------------------------------------------------------------------------
# Fastify(API) 주소 — 화면 서버에서만
# -----------------------------------------------------------------------------
# 비우면 http://127.0.0.1:3001 (src/lib/api.ts).
# ★ NEXT_PUBLIC_ 을 붙이지 않는다 — /auth/login 응답 본문에 세션 원문이 있어 브라우저에 주소를 내리지 않는다.
API_BASE_URL=

# -----------------------------------------------------------------------------
# 회의실 현황판 QR 이 가리킬 ERP 주소 — 화면 서버에서만
# -----------------------------------------------------------------------------
# 비우면 https://erp.swonbiz.com (src/app/kiosk/page.tsx). 개발기에서는 태블릿이 열 수 있는 주소로.
ERP_PUBLIC_ORIGIN=
