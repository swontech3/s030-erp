# =============================================================================
# erp-api.env 견본 — 실제 파일은 저장소 밖 %SWONBIZ_ENV_DIR%\erp-api.env (없으면 C:\workspace\env\)
# =============================================================================
# ★ 이 견본에는 **값을 적지 않는다.** 칸 이름과 설명만 둔다(결정 2026-10-24).
# ★ 읽는 쪽: API 서버(common + erp-api) · erp_app 으로 RLS 를 재는 스크립트.
#   화면은 읽지 않는다. 관리자(postgres) 접속은 여기 두지 않는다 — admin.env.
# ★ 운영(가동계) 메모는 「운영:」 줄에 적는다 — 옛 packages/api/.env.production.example 을 합쳤다.
#   무엇을 왜 바꾸는지는 doc/배포_계통전환.md.

# -----------------------------------------------------------------------------
# 1. 삐용 연동 켜고 끄기 — 주소(BBIYONG_SYSTEM · BBIYONG_BASE_URL)는 common.env
# -----------------------------------------------------------------------------
# true 면 삐용을 부르지 않고 가짜로 답한다.
#   운영: false. NODE_ENV=production 에서 true 면 env.ts 가 기동을 막는다.
BBIYONG_MOCK=
# 권한 조회 방식 mock | http. **기본값이 없다** — 비우면 기동 실패(조용히 mock 으로 뜨지 않게).
#   운영: http. ⚠️ 권한 조회 실연동(HttpBbiyongAcl)은 아직 없다(삐용 회신 ⑫ 대기) —
#        mock 이면 production 에서 막히고, http 면 구현이 없다고 던진다. 즉 지금은 가동계로 뜰 수 없다.
BBIYONG_ACL_MODE=

# 운영: production. 개발계에서는 비워 둔다.
NODE_ENV=

# -----------------------------------------------------------------------------
# 2. DB — erp_app 계정(RLS 가 걸린다)
# -----------------------------------------------------------------------------
# postgresql://erp_app:<비밀번호>@<호스트>:<포트>/postgres
#   ★ 삐용 저장소 규약: 54xxx=개발 · 55xxx=가동. 절대 섞지 않는다.
ERP_DATABASE_URL=

# -----------------------------------------------------------------------------
# 3. 세션 토큰 암호화 — AES-256-GCM (base64 32바이트)
# -----------------------------------------------------------------------------
# 만드는 법: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
#   운영: ★★ 개발계 키를 그대로 쓰지 않는다. 새로 만든다.
#   이 키가 바뀌면 기존 세션의 삐용 토큰을 복호화할 수 없다 = 전원 재로그인. 회전할 때는 세션 전체 revoke 를 같이.
ERP_ENCRYPTION_KEY=

# -----------------------------------------------------------------------------
# 4. Supabase Storage — 첨부 서류 (루트 .env 와 겹치던 칸 — 이 파일이 정본)
# -----------------------------------------------------------------------------
SUPABASE_URL=
# role 이 service_role 이어야 한다 — env.ts 가 기동 시 검사하고 아니면 죽는다.
#   운영: ⚠️⚠️ 개발계 스택은 self-hosted 샘플의 공개된 기본 JWT_SECRET 을 쓴다.
#        가동계 전에 JWT_SECRET 을 교체하고 그 비밀로 새 키를 발급받는다.
SUPABASE_SERVICE_ROLE_KEY=

# -----------------------------------------------------------------------------
# 5. 없어도 기동하는 값 — 그 기능만 꺼진다
# -----------------------------------------------------------------------------
# 구글 Vision 서비스계정 키 파일 — **절대경로**로 적는다. 키 파일은 이 폴더(C:\workspace\env\)에 둔다.
#   없으면 OCR 라우트만 503(계약은 손으로 등록할 수 있다).
#   ⚠️ 이 키는 예전에 zip 으로 유출된 적이 있다(doc/BACKEND_ANALYSIS.md). 운영: 가동계 전에 회전한다.
#      GCP 프로젝트 swon-office · 서비스계정 swon-ocr-manager.
GOOGLE_APPLICATION_CREDENTIALS=
# 국세청 상태조회(공공데이터포털). 없으면 [확인] 버튼만 「확인하지 못했습니다」.
DATA_GO_KR_KEY=
# Claude API 키 — 사업목적 「추천」 탭 [AI 추천](2026-10-27). 값은 대표가 넣는다.
#   없으면 [AI 추천]만 「쓸 수 없습니다」 — 일반 추천은 그대로. 모델 · 길이 설정은 공통 코드 AI_SETTING.
ANTHROPIC_API_KEY=

# -----------------------------------------------------------------------------
# 6. 포트
# -----------------------------------------------------------------------------
# 3001. ★ 외부에 노출하지 않는다 — 127.0.0.1 에만 바인딩한다(src/index.ts).
#   /auth/login 응답 본문에 세션 원문이 들어 있다.
PORT=
