# =============================================================================
# common.env 견본 — 실제 파일은 저장소 밖 %SWONBIZ_ENV_DIR%\common.env (없으면 C:\workspace\env\)
# =============================================================================
# ★ 이 견본에는 **값을 적지 않는다.** 칸 이름과 설명만 둔다(결정 2026-10-24).
# ★ API 서버 · 화면 · 스크립트가 **모두** 읽는다 — 화면도 읽으므로 **비밀값을 넣지 않는다.**
# ★ 같은 칸을 다른 파일에 또 두면 읽는 쪽이 기동을 멈춘다(packages/shared/src/envFiles.js).

# -----------------------------------------------------------------------------
# 삐용 계통 — ★★ 두 줄은 한 쌍이다. 하나만 바꾸면 배너가 거짓말을 한다.
# -----------------------------------------------------------------------------
# 개발계 dev · 가동계 prod
BBIYONG_SYSTEM=
# 삐용 **API** 주소(:8082). 화면 주소가 아니다 — 화면 주소는 erp-web.env 의 NEXT_PUBLIC_BBIYONG_WEB_URL.
#   개발계 http://192.168.0.22:8082
#   가동계 **HTTPS 로만**(삐용 회신 ①). http 면 API 가 기동하지 않는다.
BBIYONG_BASE_URL=
