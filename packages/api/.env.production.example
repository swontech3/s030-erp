# =============================================================================
# 가동계(운영) 환경 파일 **견본** — packages/api/.env.production.example
# =============================================================================
# ★ 이 파일은 저장소에 커밋된다. **비밀값을 적지 않는다.** 비밀번호·키 자리는
#   `<채울 것>` 으로 비워 두고, 실제 값은 배포 서버의 `packages/api/.env` 에만 넣는다.
#   (`.gitignore` 가 `.env` 를 막는다. 이 견본은 파일명이 달라서 커밋된다.)
#
# 쓰는 법: 배포 서버에서 이 파일을 `.env` 로 복사하고 `<채울 것>` 을 채운다.
#     cp packages/api/.env.production.example packages/api/.env
#
# 무엇을 왜 바꾸는지는 `doc/배포_계통전환.md` 에 있다. 이 파일은 값만 나열한다.

# =============================================================================
# 1. 삐용 계통 — 개발계와 여기만 다르면 된다
# =============================================================================
# ★★ 이 두 줄은 **한 쌍이다.** 하나만 바꾸면 배너가 거짓말을 한다.
#    개발계는  BBIYONG_SYSTEM=dev  · http://192.168.0.22:8082
BBIYONG_SYSTEM=prod
# ★ 가동계는 **HTTPS 로만** 주고받는다(삐용 회신 ①). http 면 기동하지 않는다.
#   ⚠️ 삐용이 준 가동계 주소는 지금 `http://192.168.0.14:8082` 로 **HTTPS 가 아니다.**
#      삐용 쪽 HTTPS 가 켜지면 아래를 그 주소로 확정한다. 그때까지 이 파일로는 뜨지 않는다.
BBIYONG_BASE_URL=https://192.168.0.14:8082

# ★ 가동계에서는 mock 이 금지다 — NODE_ENV=production 이면 env.ts 가 기동을 막는다.
BBIYONG_MOCK=false
# ⚠️ 권한 조회 실연동(HttpBbiyongAcl)은 **아직 없다**(삐용 회신 ⑫ 대기).
#    `mock` 이면 NODE_ENV=production 에서 기동이 막히고, `http` 면 구현이 없다고 던진다.
#    **즉 지금은 가동계로 뜰 수 없다.** 회신 ⑫ 가 와서 구현이 붙으면 `http` 로 확정한다.
BBIYONG_ACL_MODE=http

NODE_ENV=production

# =============================================================================
# 2. DB — 운영 인스턴스
# =============================================================================
# ★ 삐용 저장소 규약: 54xxx=개발 · 55xxx=가동. 절대 섞지 않는다.
#   개발계는 `192.168.0.14:54322` 였다. 가동계 포트·호스트는 배포 시 확정한다.
ERP_DATABASE_URL=postgresql://erp_app:<채울 것>@<운영 DB 호스트>:<55xxx>/postgres

# =============================================================================
# 3. 세션 토큰 암호화 — AES-256-GCM (base64 32바이트)
# =============================================================================
# ★★ **개발계 키를 그대로 쓰지 않는다.** 새로 만든다:
#      node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
#    이 키가 바뀌면 기존 세션의 삐용 토큰을 복호화할 수 없다 = 전원 재로그인이다.
#    회전할 때는 세션 전체 revoke 를 같이 계획한다.
ERP_ENCRYPTION_KEY=<채울 것 — 새로 생성>

# =============================================================================
# 4. Supabase Storage — 첨부 서류
# =============================================================================
# ⚠️⚠️ **개발계 스택은 self-hosted 샘플의 공개된 기본 JWT_SECRET 을 쓰고 있다.**
#      그 값을 아는 사람은 누구나 service_role 토큰을 만들 수 있다.
#      **가동계로 가기 전에 JWT_SECRET 을 교체하고, 그 비밀로 새 키를 발급받는다.**
SUPABASE_URL=<채울 것 — 운영 게이트웨이>
# ★ role 이 service_role 이어야 한다 — env.ts 가 기동 시 검사하고 아니면 죽는다.
SUPABASE_SERVICE_ROLE_KEY=<채울 것 — 새 JWT_SECRET 으로 발급>

# =============================================================================
# 5. 없어도 기동하는 값 — 그 기능만 꺼진다
# =============================================================================
# ⚠️ 이 키는 예전에 zip 으로 유출된 적이 있다(doc/BACKEND_ANALYSIS.md).
#    **가동계 전에 회전한다.** GCP 프로젝트 swon-office · 서비스계정 swon-ocr-manager.
#    없으면 OCR 라우트만 503 이다(계약은 손으로 등록할 수 있다).
GOOGLE_APPLICATION_CREDENTIALS=secrets/google-ocr.json

# 국세청 상태조회. 없으면 [확인] 버튼만 「확인하지 못했습니다」라고 답한다.
DATA_GO_KR_KEY=<채울 것>

# =============================================================================
# 6. 포트
# =============================================================================
# ★ 이 서버는 외부에 노출하지 않는다 — 127.0.0.1 에만 바인딩한다(src/index.ts).
#   /auth/login 응답 본문에 세션 원문이 들어 있다.
PORT=3001
