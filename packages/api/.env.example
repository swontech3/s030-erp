# =============================================================================
# packages/api/.env — 개발계 견본 (값은 모두 비워 둔다)
# =============================================================================
# 이 파일을 `.env` 로 복사해서 값을 채운다. ★ `.env` 는 .gitignore 에 걸려 있다.
#     cp packages/api/.env.example packages/api/.env
# 가동계 견본은 `.env.production.example` 이다.
# ★ 환경변수는 기동 시 한 번만 읽는다 — 바꾸면 API 를 다시 띄운다.

# -----------------------------------------------------------------------------
# DB — ERP 전용 접속 (erp_app 역할)
# -----------------------------------------------------------------------------
# 형식 : postgresql://erp_app:<비밀번호>@<DB 호스트>:<포트>/postgres
# ★ 포트 규약 : 54xxx = 개발계 · 55xxx = 가동계
ERP_DATABASE_URL=

# -----------------------------------------------------------------------------
# 세션 토큰 암호화 키 — AES-256-GCM (base64 32바이트)
# -----------------------------------------------------------------------------
# 만드는 법 : node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# ★ 바뀌면 기존 세션 전원 재로그인
ERP_ENCRYPTION_KEY=

# -----------------------------------------------------------------------------
# 삐용 연동
# -----------------------------------------------------------------------------
# 인증을 mock 으로 할지 (true / false)
BBIYONG_MOCK=
# 계통 (dev / prod) — 아래 BBIYONG_BASE_URL 과 한 쌍으로 같이 바꾼다
BBIYONG_SYSTEM=
# 삐용 백엔드(API) 주소 — 개발계는 삐용을 띄운 PC 의 :8082
BBIYONG_BASE_URL=
# 권한 조회 방식 (mock / http)
BBIYONG_ACL_MODE=

# -----------------------------------------------------------------------------
# API 서버 포트 (127.0.0.1 에만 바인딩. 화면이 기본으로 3001 을 부른다)
# -----------------------------------------------------------------------------
PORT=

# -----------------------------------------------------------------------------
# Supabase Storage — 첨부 서류
# -----------------------------------------------------------------------------
# 게이트웨이 주소 (Kong · 개발계 :54321)
SUPABASE_URL=
# role 이 service_role 인 키 — 기동 시 검사하고 아니면 죽는다
SUPABASE_SERVICE_ROLE_KEY=

# -----------------------------------------------------------------------------
# 없어도 기동하는 값 — 그 기능만 꺼진다
# -----------------------------------------------------------------------------
# 구글 Vision OCR 서비스 계정 키 파일 경로 (packages/api 기준 상대경로 · secrets/ 아래)
GOOGLE_APPLICATION_CREDENTIALS=
# 공공데이터포털 사업자 상태조회 키 (디코딩된 64자)
DATA_GO_KR_KEY=
