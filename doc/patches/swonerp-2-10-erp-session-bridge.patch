+++ b/src/lib/erp-session-map.test.ts
@@ -0,0 +1,56 @@
+import { describe, it, expect } from "vitest";
+import { mapErpSessionToAuthContext, type ErpSessionRow } from "./erp-session-map";
+
+const now = new Date("2026-09-07T12:00:00Z");
+const live = (over: Partial<ErpSessionRow> = {}): ErpSessionRow => ({
+  bbiyong_member_id: 2001,
+  org_tp: "C",
+  org_id: 9001,
+  expires_at: new Date("2026-09-14T12:00:00Z"),
+  revoked_at: null,
+  ...over,
+});
+
+describe("mapErpSessionToAuthContext", () => {
+  it("행이 없으면 null (Supabase 경로로 폴백하게 둔다)", () => {
+    expect(mapErpSessionToAuthContext(null, now)).toBeNull();
+  });
+
+  it("revoked_at 이 있으면 null — 로그아웃된 세션", () => {
+    expect(mapErpSessionToAuthContext(live({ revoked_at: new Date("2026-09-07T11:00:00Z") }), now)).toBeNull();
+  });
+
+  it("expires_at 이 지났으면 null (경계: 같은 시각도 만료)", () => {
+    expect(mapErpSessionToAuthContext(live({ expires_at: new Date("2026-09-07T11:59:59Z") }), now)).toBeNull();
+    expect(mapErpSessionToAuthContext(live({ expires_at: now }), now)).toBeNull();
+  });
+
+  it("입주사(org_tp≠S) → role C · isAdmin false", () => {
+    const ctx = mapErpSessionToAuthContext(live(), now);
+    expect(ctx).not.toBeNull();
+    expect(ctx!.role).toBe("C");
+    expect(ctx!.isAdmin).toBe(false);
+    expect(ctx!.userId).toBe("bbiyong:2001");
+  });
+
+  it("운영사(org_tp=S) → role A · isAdmin true (표시용 매핑)", () => {
+    const ctx = mapErpSessionToAuthContext(live({ org_tp: "S", bbiyong_member_id: 1001 }), now);
+    expect(ctx!.role).toBe("A");
+    expect(ctx!.isAdmin).toBe(true);
+    expect(ctx!.userId).toBe("bbiyong:1001");
+  });
+
+  it("tenantId·organizationId 는 운영사 1행('1') — 입주사 식별자가 아니다", () => {
+    const ctx = mapErpSessionToAuthContext(live(), now)!;
+    expect(ctx.tenantId).toBe("1");
+    expect(ctx.organizationId).toBe("1");
+  });
+
+  it("반환 모양이 기존 AuthContext 키와 정확히 같다 (호출부 76곳 호환)", () => {
+    const ctx = mapErpSessionToAuthContext(live(), now)!;
+    expect(Object.keys(ctx).sort()).toEqual(
+      ["buildId", "deptCd", "empNo", "floorId", "isAdmin", "mustChangePassword",
+       "organizationId", "role", "tenantId", "userId", "userName"].sort(),
+    );
+  });
+});
