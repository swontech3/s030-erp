index 0000000..362dacf
--- /dev/null
+++ b/src/lib/erp-session.ts
@@ -0,0 +1,44 @@
+import { createHash } from "node:crypto";
+import { cookies } from "next/headers";
+import { db } from "@/lib/db";
+import { mapErpSessionToAuthContext, type ErpSessionRow } from "./erp-session-map";
+import type { AuthContext } from "./auth-context";
+
+/**
+ * erp_sid 쿠키 → AuthContext (페이즈 1 · 2-10 브리지, 전환 기간 한정).
+ *
+ * 신규 ERP(SwonBiz-erp)가 굽는 `erp_sid` 쿠키를 이 앱도 받아들인다. 쿠키 원문의
+ * SHA-256 을 `tb_s080_auth_session.erp_sid` 에서 찾는다 — 그 테이블은 해시만 저장한다.
+ *
+ * ★ 이 테이블은 Prisma 스키마에 없다(신규 ERP 의 Drizzle 이 소유). 그래서 $queryRaw 다.
+ *   여기 모델을 추가하면 두 ORM 이 같은 테이블을 소유하게 된다 — 하지 않는다.
+ * ★ 읽기만 한다. last_active_at 갱신·폐기는 신규 ERP(Fastify)의 몫이다.
+ * ★ 30초 캐시를 두지 않는다. 이 앱의 접속은 postgres 역할이라 PK 단건 조회 하나이고,
+ *   전환 기간에만 쓰는 경로라 캐시로 얻을 것보다 revoked_at 이 늦게 먹을 위험이 크다.
+ */
+export const ERP_SESSION_COOKIE = "erp_sid";
+
+export async function resolveErpSessionContext(): Promise<AuthContext | null> {
+  const store = await cookies();
+  const raw = store.get(ERP_SESSION_COOKIE)?.value;
+  if (!raw) return null; // 쿠키 없음 → 호출자가 기존 Supabase 경로로 간다
+
+  const hash = createHash("sha256").update(raw).digest("hex");
+
+  let row: ErpSessionRow | null = null;
+  try {
+    const rows = await db.$queryRaw<ErpSessionRow[]>`
+      SELECT bbiyong_member_id, org_tp, org_id, expires_at, revoked_at
+        FROM public.tb_s080_auth_session
+       WHERE erp_sid = ${hash}
+       LIMIT 1`;
+    row = rows[0] ?? null;
+  } catch (err) {
+    // 테이블이 아직 없는 환경(002 미적용)에서도 기존 앱이 죽으면 안 된다.
+    // 브리지만 조용히 비활성화하고 Supabase 경로로 넘긴다.
+    console.error("[erp-session] tb_s080_auth_session 조회 실패 — Supabase 경로로 폴백:", (err as Error).message);
+    return null;
+  }
+
+  return mapErpSessionToAuthContext(row);
+}
diff --git a/src/lib/erp-session-map.ts b/src/lib/erp-session-map.ts
new file mode 100644
index 0000000..79f5af6
--- /dev/null
+++ b/src/lib/erp-session-map.ts
@@ -0,0 +1,56 @@
+import type { AuthContext } from "./auth-context";
+
+/**
+ * ERP 세션(tb_s080_auth_session) 행 → AuthContext — 순수 함수 (페이즈 1 · 2-10 브리지).
+ *
+ * 전환 기간 한정. 신규 ERP(SwonBiz-erp)가 발급한 erp_sid 세션으로 이 앱에 들어온
+ * 요청을 기존 AuthContext 모양으로 번역한다. 반환 타입은 그대로 둔다 — 76개 호출부를
+ * 건드리지 않기 위해서다.
+ *
+ * ★ role · isAdmin 은 **표시용으로 강등된 값**이다. 이 브리지는 판정을 하지 않는다 —
+ *   org_tp 를 기존 코드값으로 옮겨 적을 뿐이고, 진짜 권한 판정은 삐용이 준 화면 목록으로
+ *   신규 ERP 쪽(Fastify)이 한다. 기존 호출부가 isAdmin 을 읽는 것은 레거시 동작이며,
+ *   그 호출부를 정리하는 일은 이 브리지의 범위가 아니다.
+ *
+ * ★ 만료·폐기 판정은 여기서 한다(DB 가 아니라). 쿼리에서 거르면 "왜 null 인지"를
+ *   테스트할 수 없다.
+ */
+export type ErpSessionRow = {
+  bbiyong_member_id: number;
+  org_tp: string;
+  org_id: number;
+  expires_at: Date;
+  revoked_at: Date | null;
+};
+
+/** 운영사(에스원비즈) 행 1건의 식별자. 기존 앱의 tenantId 는 입주사가 아니라 운영사를 가리킨다(ORG §2-4). */
+const OPERATOR_TENANT_ID = "1";
+
+export function mapErpSessionToAuthContext(
+  row: ErpSessionRow | null,
+  now: Date = new Date(),
+): AuthContext | null {
+  if (!row) return null;
+  if (row.revoked_at !== null) return null;
+  if (row.expires_at.getTime() <= now.getTime()) return null;
+
+  // 표시 전용 매핑. 'S' = 운영사 → 기존 코드의 관리자(A), 그 외 = 입주사(C).
+  const isOperator = row.org_tp === "S";
+
+  return {
+    // Supabase user.id 와 겹치지 않게 접두어를 둔다. 이 값으로 User 테이블을 찾지 않는다.
+    userId: `bbiyong:${row.bbiyong_member_id}`,
+    role: isOperator ? "A" : "C",
+    empNo: null,
+    // 이름은 삐용에만 있다(세션 테이블에 복사하지 않는다 — ORG §3-2). 표시가 필요한 화면은
+    // 신규 ERP 쪽 /auth/me 를 쓴다. 여기서는 빈 값이며 판정에 쓰이지 않는다.
+    userName: "",
+    tenantId: OPERATOR_TENANT_ID,
+    buildId: null,
+    floorId: null,
+    deptCd: null,
+    isAdmin: isOperator,
+    mustChangePassword: false,
+    organizationId: OPERATOR_TENANT_ID,
+  };
+}
diff --git a/src/lib/erp-session-map.test.ts b/src/lib/erp-session-map.test.ts
