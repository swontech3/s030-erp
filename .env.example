# =============================================================================
# 저장소 루트 .env — 견본 (값은 모두 비워 둔다)
# =============================================================================
# 이 파일을 `.env` 로 복사해서 값을 채운다. ★ `.env` 는 .gitignore 에 걸려 있다.
# 루트 `scripts/*.js` (check:grants · verify:* · seed:mock-link 등)가 읽는다.
# API 서버(Fastify)는 이 파일이 아니라 `packages/api/.env` 를 읽는다.

# -----------------------------------------------------------------------------
# DB — 삐용(s02-back) 개발계 Supabase Postgres
# -----------------------------------------------------------------------------
# ★ 포트 규약 : 54xxx = 개발계 · 55xxx = 가동계. 절대 섞지 않는다.

# DB 서버 주소
DB_HOST=
# DB 포트 (개발계 54322)
DB_PORT=
# 접속 계정
DB_USER=
# 접속 계정 비밀번호
DB_PASSWORD=
# 데이터베이스 이름
DB_NAME=

# -----------------------------------------------------------------------------
# Supabase
# -----------------------------------------------------------------------------
# 게이트웨이 주소 (Kong · 개발계 :54321)
SUPABASE_URL=
# anon 키 — 스크립트가 anon 동작을 확인할 때 쓴다
SUPABASE_ANON_KEY=
# 스크립트용 키. 진짜 service_role 키는 packages/api/.env 에 넣는다
SUPABASE_SERVICE_ROLE_KEY=

# -----------------------------------------------------------------------------
# 공공데이터포털 「사업자등록정보 진위확인 및 상태조회」 인증키
# -----------------------------------------------------------------------------
# 디코딩된 키(64자). URL 인코딩된 쪽을 넣으면 401 이 난다
DATA_GO_KR_KEY=
